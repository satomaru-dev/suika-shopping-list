# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# First setup only. Use a long random value and remove it after PIN setup.
APP_SETUP_SECRET=replace-with-a-long-random-secret

# true lets you inspect the UI without Supabase. Never use it for real data.
DEMO_MODE=true

# Optional: override the recommendation calculation date in demo/tests only.
DEMO_TODAY=2026-08-11
